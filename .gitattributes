# Detect other text files automatically
* text=auto

# Current source, configuration and documentation
*.py text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.python-version text eol=lf
LICENSE text eol=lf

# Future binary resources: never normalize line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary
*.dll binary
*.pyc binary

# GitHub Actions configuration
*.yml text eol=lf
*.yaml text eol=lf
